<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hdfs-site.xml — Stock Market Big Data Project
  Single-node pseudo-distributed HDFS on WSL2 Ubuntu
-->
<configuration>

    <!-- ===== Replication ===== -->
    <property>
        <name>dfs.replication</name>
        <value>1</value>
        <description>Single-node setup; one replica is sufficient.</description>
    </property>

    <!-- ===== NameNode Storage ===== -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///home/${user.name}/hadoop_data/hdfs/namenode</value>
        <description>Local directory where the NameNode stores its metadata.</description>
    </property>

    <!-- ===== DataNode Storage ===== -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///home/${user.name}/hadoop_data/hdfs/datanode</value>
        <description>Local directory where DataNode stores its blocks.</description>
    </property>

    <!-- ===== NameNode Web UI ===== -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>localhost:9870</value>
        <description>NameNode web UI (Hadoop 3.x default).</description>
    </property>

    <!-- ===== Secondary NameNode ===== -->
    <property>
        <name>dfs.namenode.secondary.http-address</name>
        <value>localhost:9868</value>
    </property>

    <!-- ===== Block Size ===== -->
    <property>
        <name>dfs.blocksize</name>
        <value>134217728</value>
        <description>Block size: 128 MB (default for Hadoop 3.x).</description>
    </property>

    <!-- ===== Permissions ===== -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
        <description>Disable permission checking in development.</description>
    </property>

    <!-- ===== DataNode Transfer / IPC ===== -->
    <property>
        <name>dfs.datanode.address</name>
        <value>0.0.0.0:9866</value>
    </property>
    <property>
        <name>dfs.datanode.ipc.address</name>
        <value>0.0.0.0:9867</value>
    </property>

    <!-- ===== Heartbeat & Recheck ===== -->
    <property>
        <name>dfs.namenode.heartbeat.recheck-interval</name>
        <value>300000</value>
        <description>5 minutes (ms). Tolerant setting for WSL2.</description>
    </property>

    <!-- ===== Client Retry ===== -->
    <property>
        <name>dfs.client.retry.policy.enabled</name>
        <value>true</value>
    </property>

</configuration>
